  "commands": [
    {
      "phrases": [
        "öffne [die app] {app}",
        "starte [die app] {app}",
        "(mach|mache) {app} auf",
        "{app} (öffnen|starten)"
      ],
      "say": "{app} wird gestartet",
      "action": {
        "type": "run",
        "target": "{app.value}"
      },
      "en": {
        "phrases": [
          "open [the] [app] {app}",
          "start [the] [app] {app}",
          "launch {app}",
          "run {app}"
        ],
        "say": "Starting {app}"
      }
    },
    {
      "phrases": [
        "schließe [die app] {app}",
        "beende [die app] {app}",
        "(mach|mache) {app} zu"
      ],
      "say": "{app} wird geschlossen",
      "action": {
        "type": "run",
        "target": "taskkill.exe",
        "args": [
          "/IM",
          "{app.process}"
        ]
      },
      "en": {
        "phrases": [
          "close [the] [app] {app}",
          "quit {app}",
          "exit {app}"
        ],
        "say": "Closing {app}"
      }
    }
  ]
